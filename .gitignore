# Build intermediates (the shipped build/VBox52.dll is kept on purpose)
build/*.obj
build/*.lib
build/*.exp
build/*.pdb
build/*.ilk
build/*.b64
build/chunk_*
build/MSVCP140.dll
build/VCRUNTIME140.dll

# Windows reserved name artifact (created accidentally by redirect to NUL)
nul

# Patcher backups
*.bak
*.bak_*

# Runtime / diagnostic logs
*.log

# Reverse-engineering scratch output (the curated .md in analysis/output is kept)
analysis/output/*.json
analysis/output/*.csv

# Local RE database / large scratch
ruvector.db
*.db

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Release artifacts (uploaded to GitHub Releases, not tracked in-repo)
Releases/

# Crash dumps and large RE binaries (kept on disk, not tracked)
*.dmp
analysis/ngfw/*.dll
analysis/ngfw/*.exe

# Experimental shim builds (the shipped build/VBox52.dll stays tracked on purpose).
# These come from toolchain experiments (LLVM-MinGW, binary-patch A/B variants);
# they are throwaway artifacts, never shipped.
build/VBox52_llvm*.dll
build/VBox52_candidate.dll
build/VBox52_noinject.dll
build/VBox52_efail.dll
build/VBox52_v013beta.dll
build/candidate_*.def

# Python bytecode
__pycache__/
*.pyc

# Agent/tooling scratch
.claude-flow/
build/VBox52_nodel.bak.dll
build/VBox52_vboxerr.dll
